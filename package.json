{
  "name": "bmsman",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:reset": "node scripts/reset-dev.mjs",
    "dev:clean": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\" && next dev -p 3000",
    "prebuild": "node scripts/prebuild-guard.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "api:lint": "npx --yes @redocly/cli@latest lint ${BMS_API_SPEC:-../BMS-backend/docs/api/bms-api.yaml}",
    "api:mock": "npx --yes @stoplight/prism-cli@5.14.2 mock ${BMS_API_SPEC:-../BMS-backend/docs/api/bms-api.yaml} -p 4010",
    "api:types": "npx --yes openapi-typescript@7 ${BMS_API_SPEC:-../BMS-backend/docs/api/bms-api.yaml} -o lib/frp/schema.d.ts",
    "db:seed": "echo 'Supabase seed retired — seed via Spring Boot / DataSeeder'",
    "align:quotes": "echo 'Supabase quote align retired — DEL-02'",
    "test:webhook": "echo 'Supabase webhook test retired — DEL-02'"
  },
  "dependencies": {
    "@faker-js/faker": "^9.8.0",
    "buffer": "^6.0.3",
    "framer-motion": "^12.40.0",
    "geist": "^1.7.0",
    "lucide-react": "^0.511.0",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
