# Copy to .env.local (never commit .env.local)

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required for webhook + db:seed (bypasses RLS). Supabase → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Quotient webhook auth (Settings → Integrations → Webhooks in Quotient)
QUOTIENT_WEBHOOK_SECRET=generate-a-long-random-string

# Optional override for scripts/test-webhook.ts
WEBHOOK_TEST_URL=http://localhost:3000

# FRP Spring Boot API (Super Admin / organizations)
NEXT_PUBLIC_FRP_API_BASE_URL=http://localhost:8080/api/v1
