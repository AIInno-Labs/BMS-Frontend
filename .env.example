# Copy to .env (or .env.local). Never commit real secrets.
# Restart `npm run dev` after changing env files.

# -----------------------------------------------------------------------------
# Required — Spring Boot BMS API (includes context-path /api/v1)
# Backend: server.servlet.context-path=/api/v1/
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FRP_API_BASE_URL=http://localhost:8080/api/v1
# Production Cloud Run:
# NEXT_PUBLIC_FRP_API_BASE_URL=https://frp-684387770054.asia-south1.run.app/api/v1

# -----------------------------------------------------------------------------
# DEL-02 — Quotient (quotes + webhook)
# Webhook secret validates inbound Quotient callbacks (Bearer / x-webhook-secret).
# API key + base URL are for outbound Quotient API calls (org params mirror these
# names in IntegrationParamCodes / Org → Integrations).
# -----------------------------------------------------------------------------
QUOTIENT_WEBHOOK_SECRET=generate-a-long-random-string
QUOTIENT_API_KEY=
QUOTIENT_BASE_URL=
QUOTIENT_ENABLED=false

# -----------------------------------------------------------------------------
# DEL-02 — SharePoint / Microsoft Graph (job document folders)
# Names match BMS-backend IntegrationParamCodes (org-editable via /org/integrations).
# SHAREPOINT_CLIENT_SECRET is the Azure app secret ("API key").
# -----------------------------------------------------------------------------
SHAREPOINT_ENABLED=false
SHAREPOINT_SITE_URL=
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_DRIVE_ID=
